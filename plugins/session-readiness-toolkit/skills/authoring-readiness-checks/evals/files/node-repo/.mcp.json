{
    "mcpServers": {
        "github": {
            "command": "docker",
            "args": [
                "run",
                "-i",
                "--rm",
                "-e",
                "GITHUB_PERSONAL_ACCESS_TOKEN=${ACME_GITHUB_TOKEN}",
                "ghcr.io/github/github-mcp-server:v1.11.0"
            ]
        },
        "playwright": {
            "command": "npx",
            "args": ["-y", "@playwright/mcp@0.0.80", "--browser=chrome", "--headless"]
        }
    }
}
